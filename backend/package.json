{
  "name": "user-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for user_management",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
